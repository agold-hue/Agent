    "@browserbasehq/sdk": "^2.20.0",
    "googleapis": "^170.0.0",
    "playwright-core": "^1.58.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vercel/node": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  }
