{
  "name": "workmate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A 24/7 AI worker for businesses: monitors mail, browses and fills out sites, chats with support, buys and returns, follows up, generates PDFs. One long-running service on Claude + Playwright.",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json && cp -r src/web dist/web && cp -r db dist/db && cp src/agent/prompt.md dist/agent/prompt.md",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "db:migrate": "tsx src/scripts/migrate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "croner": "^10.0.1",
    "imapflow": "^1.0.200",
    "mailparser": "^3.9.0",
    "marked": "^18.0.0",
    "nodemailer": "^7.0.0",
    "pdfjs-dist": "^5.7.0",
    "pg": "^8.23.0",
    "playwright": "1.56.1",
    "stripe": "^22.6.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
