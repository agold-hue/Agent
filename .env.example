# ---- Service ----
APP_URL=https://your-app.vercel.app
DATABASE_URL=postgres://...            # Neon / Vercel Postgres / any Postgres
MASTER_KEY=                             # 32 random bytes, base64: openssl rand -base64 32
SESSION_SECRET=                         # any long random string
CRON_SECRET=                            # Vercel sends this as a Bearer token on cron calls

# ---- Models (any OpenAI-compatible provider; OpenRouter gives one key for DeepSeek, Gemini, Claude, GPT...) ----
LLM_BASE_URL=https://openrouter.ai/api/v1   # or https://api.deepseek.com/v1, https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
# Google direct: set GEMINI_API_KEY (aistudio.google.com/apikey). Used when it is the only key, or with LLM_PROVIDER=gemini;
# everything then routes to Google's endpoint with gemini-2.5-flash-lite / gemini-2.5-flash / gemini-2.5-pro unless MODEL_* override.
# With both keys set, OpenRouter is the default (LLM_PROVIDER=openrouter makes that explicit).
GEMINI_API_KEY=
LLM_PROVIDER=
# Three tiers; any model id your provider accepts. Cheap first; the agent escalates when stuck.
MODEL_CHAT=google/gemini-3.8-flash            # acknowledgements, calendar notes, recall, digests
MODEL_TASK=anthropic/claude-sonnet-5          # routine browser work, reorders, forms, drafting, reviews, documents
MODEL_HARD=anthropic/claude-opus-5            # refunds, negotiations, bills and accounts, anything needing judgment
# Cheaper (the older defaults; misses more): MODEL_CHAT=google/gemini-2.5-flash-lite MODEL_TASK=google/gemini-3.8-flash MODEL_HARD=anthropic/claude-sonnet-5
# Optional per-plan overrides: MODEL_TASK_PRO=..., MODEL_HARD_STARTER=...
# A tier can be a list: the next model answers when the first is down or rate-limited (OpenRouter fallback chain).
# MODEL_TASK=google/gemini-3.8-flash,deepseek/deepseek-chat,anthropic/claude-haiku-4.5
# OpenRouter picks the provider serving the chosen model by throughput (default, fastest), price or latency:
# LLM_SORT=throughput
# Let OpenRouter choose the model itself per request (quality-oriented, not cheapest): MODEL_TASK=openrouter/auto
# On OpenRouter every tier automatically gets a fallback chain behind it (the three catalog models closest in
# price and capability, one per vendor, then openrouter/auto), and an id the catalog does not know is replaced
# instead of failing. LLM_AUTO_FALLBACK=off disables that; LLM_AUTO_FALLBACK_COUNT=3 sets how many.
# Any OpenRouter id works; GET /api/models (logged in) lists all of them with prices and tool/image support.
# Optional direct providers by model prefix (bill Anthropic or DeepSeek directly instead of via OpenRouter):
# LLM_PROVIDERS={"anthropic-direct:":{"base_url":"https://api.anthropic.com/v1","api_key":"sk-ant-..."}}
# MODEL_HARD=anthropic-direct:claude-sonnet-5
# Cheaper task tier (about 40% of Gemini Flash's price; less reliable on long browser tasks, escalation catches failures):
# MODEL_TASK=deepseek/deepseek-chat
LLM_PROVIDERS=
# Prices per million tokens for cost caps; extend for models not in lib/llm.ts
MODEL_PRICES={}
# Models that can look at screenshots (substring match)
VISION_MODELS=gemini,gpt-4o,gpt-5,claude
SESSION_BUDGET_USD=3                          # hard cap per task
# Monthly model-spend cap per customer, by plan (Stripe price metadata "plan"; DEFAULT for prices without one).
# Rough guide: a light user spends $10-30/mo, a daily user $30-80, a 5-hour-a-day power user $60-120 with caching.
PLAN_CAP_USD_DEFAULT=30
PLAN_CAP_USD_PLUS=90
PLAN_CAP_USD_PRO=250
MAX_TURNS_PER_TASK=100                        # steps one task may take (from the user's latest message) before it stops with a summary
LOOKUP_BUDGET_USD=0.50                        # spend cap for a task-tier lookup (a balance, a price, a figure off a page): it stops with a summary, the user can say "keep going"
# TASK_BUDGET_USD=3                           # spend cap for any other task (defaults to SESSION_BUDGET_USD); 0 disables
# TOOL_TURN_MAX_TOKENS=1200                  # output cap for a turn that follows a tool result (another tool call or a short reply); 0 = no cap
# RECAP_AFTER_MESSAGES=12                     # in a long chat thread, earlier tasks collapse to one recap note once this many messages precede the current task
# SOFT_LANDING_HARD=0.8  SOFT_LANDING_TASK=0.95  # share of the monthly cap at which the hard tier steps down to task, and task to chat, instead of a hard stop later
# HARD_DOMAINS=                               # extra sites that go to the hard tier from step one (banks, airlines, government portals are built in)
# LLM_FIRST_TOKEN_MS=10000                    # no token (content, reasoning or a tool call; keepalives do not count) by then and the request moves to the next model in the chain
# EXTRACT_MAX_CHARS=14000                     # browser_extract output cap
# SITE_NOTE_MIN_STEPS=5                       # a browser task with this many steps on a site and no sites/<domain>.md is asked to write one before it finishes
# Cheaper reads in account portals (balances, spending totals, order status) need no strong model: trial MODEL_TASK=google/gemini-3.8-flash
# and compare the cost column in the Tasks tab; ACTION_SNAPSHOT_ELEMENTS=80 shrinks every browser step on menu-heavy portals.
TASK_TIME_LIMIT_MINUTES=15                    # wall clock per task, not counting time spent waiting for the user
PROGRESS_NOTE_MINUTES=3                       # a silent task this old is told to post a one-line progress note (tell_user)
MAX_TURNS_PER_SESSION=300                     # ceiling for one chat thread; then it rolls over to a fresh one with a recap
PARALLEL_TASKS=20                             # requests sent while the chat is busy run as their own tasks, up to this many at once (one shared browser, a tab each)
LOOP_LIMIT=6                                  # identical steps in a row (or a repeating 2-3 step cycle) that count as stuck
RECENT_TOOL_RESULTS=6                         # tool outputs kept whole in the model's context; older page snapshots are stubbed on every call
ACTION_SNAPSHOT_ELEMENTS=140                  # page elements returned with a click/type/scroll; browser_snapshot lists up to 250
KICK_WAIT_MS=1200                             # how long a chat request waits for the worker kick to be delivered
# SIBLING_WAIT_MS=600                         # a fresh message waits this long for siblings typed right after it before its run starts
# STALL_KICK_MS=4000                          # the chat page re-kicks a running session that has no lease and nothing written for this long (instead of waiting for the cron sweep)
CONTEXT_TOKEN_BUDGET=40000                    # per-call context cap; long tasks get older tool output trimmed first
PROMPT_CACHE=on                               # cache breakpoints on Claude models (input at 10% after the first call); Gemini/DeepSeek cache on their own

# ---- Web search and reading (over HTTPS from the server; the browser is only for logins and actions) ----
# Search API keys, any or none: Brave (api.search.brave.com), Serper (serper.dev), Tavily (tavily.com). Without a key
# the keyless DuckDuckGo HTML endpoint is used, which rate-limits and captcha-walls under load. Engines are tried in
# SEARCH_ENGINES order until one answers; an empty or blocked result is never shown to the model as results.
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=
# SEARCH_ENGINES=brave,serper,tavily,duckduckgo
# SEARCH_TIMEOUT_MS=5000                      # per engine call; the next engine is tried after it
# FETCH_TIMEOUT_MS=6000                       # per page read; a slow page comes back as "could not read" while the rest are returned
# SEARCH_RESULTS_PER_QUERY=10
# Results and page text are cached in Postgres and shared across customers (a result page is the same for everyone):
# SEARCH_CACHE=on  SEARCH_CACHE_FRESH_MINUTES=20 (since=day)  SEARCH_CACHE_HOURS=24 (evergreen)  PAGE_CACHE_HOURS=12
# FETCH_BUDGET_PER_TASK=12                    # pages a task may read before it must answer or ask; an approved research checkpoint adds 12
# PAGE_CONDENSE_CHARS=6000                    # pages longer than this are condensed by the chat-tier model around the question, in parallel
# PAGE_MAX_CHARS=7000                         # a page the fast model could not condense is cut here
# SEARCH_STALE_DAYS=365                       # a price/hours/policy result older than this is flagged "verify before repeating"
# Per customer: settings.country (US, GB...) and settings.city ("Brooklyn, NY", a zip) steer results; the country defaults from the time zone.
# The golden set (eval/search-golden.json, 50 questions with known answers): npm run eval:search, or nightly:
# SEARCH_EVAL_NIGHTLY=on  SEARCH_EVAL_HOUR_UTC=3  SEARCH_EVAL_NIGHTLY_COUNT=10   (results in search_evals and on /api/stats)
# BROWSER_IDLE_RELEASE_MINUTES=5              # a hosted browser with no running or waiting session on it this long is released (it is billed by the minute)

# ---- Host initiative ----
# PENDING_REMIND_BEFORE_MINUTES=60  PENDING_REMIND_AFTER_HOURS=2   # one push before an approval/question expires (or after quiet hours)
# APPROVAL_PROPOSAL_AFTER=3        # approvals of the same kind at the same merchant before Pete offers a standing rule
# GRADE_SAMPLE=0.34                # share of finished tasks graded by the fast model; the week's top flaw becomes a preferences line on Sunday
# READINGS_REFRESH_HOUR=4  READINGS_MIN_USES=2   # overnight refresh of figures from recorded paths the customer replays often
# LLM_PROVIDER_PINNING=on          # order OpenRouter providers by our own measured first-token time per model

# ---- Documents (PDFs the user attaches or emails) ----
# Short files are inlined; longer ones are stored page by page with an outline and read through the document tool.
# DOCUMENT_INLINE_CHARS=12000   DOCUMENT_READ_MAX_PAGES=6   DOCUMENT_REVIEW_CHUNK_CHARS=14000   DOCUMENT_REVIEW_MAX_CHUNKS=16
# Scanned PDFs (no text layer) are read by OCR through OpenRouter's PDF parser on the chat-tier model (paid per page by the engine):
# PDF_OCR=on   PDF_OCR_ENGINE=mistral-ocr   PDF_OCR_MAX_PAGES=30   PDF_OCR_MODEL=

# ---- No-browser data sources ----
# Bank balances and transactions through Plaid (Settings > Bank accounts; read-only). PLAID_ENV: sandbox | development | production
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# PLAID_COUNTRY_CODES=US   PLAID_REDIRECT_URI=
# Package tracking by carrier API (free developer accounts); a carrier without keys falls back to the inbox or the browser.
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
# Change watches (watch_page): WATCH_MIN_MINUTES=15  WATCHES_PER_USER=30  WATCHES_PER_TICK=8
# Local browser relay (the extension in extension/): RELAY_ONLINE_MS=25000  RELAY_COMMAND_TIMEOUT_MS=30000
# Adaptive tiers (start a task one tier lower once this customer's history there is clean): ADAPTIVE_TIERS=on  ADAPTIVE_MIN_SUCCESSES=3  ADAPTIVE_LOOKBACK_DAYS=60
# Deferred model calls through Anthropic's half-price batch endpoint (post-mortems); without the key they run immediately as before.
ANTHROPIC_API_KEY=
# BATCH_MODEL=claude-haiku-4-5-20251001   BATCH_API=on

# ---- Test deploy shortcut ----
# With only DATABASE_URL, LLM_API_KEY, MASTER_KEY, SESSION_SECRET, CRON_SECRET and DEV_LOGIN_CODE set, the app runs:
# everyone logs in with the shared DEV_LOGIN_CODE, everyone has access (no Stripe), chat works, browsing and the
# email channel are off until Browserbase and Postmark are added. The schema is applied on first use. APP_URL
# falls back to the Vercel production URL. Remove DEV_LOGIN_CODE before real customers.
DEV_LOGIN_CODE=

# ---- Browserbase (hosted browsers; one persistent profile per customer) ----
BROWSERBASE_API_KEY=bb_live_...
BROWSERBASE_PROJECT_ID=...
# BROWSER_STEALTH=1                          # Browserbase advanced stealth (Scale plan): gets past more bot checks on utility and bank sites
# BROWSER_PROXY=1                            # route the browser through a residential proxy: slower on every page, needed only for sites that block data-center IPs
# PAGE_SETTLE_MS=8000                        # how long a navigation may take to draw its controls before the agent reads the page

# ---- Mail (Postmark; one server, inbound enabled on MAIL_DOMAIN) ----
POSTMARK_SERVER_TOKEN=...
MAIL_DOMAIN=agents.example.com          # each customer is <slug>@MAIL_DOMAIN; set the inbound webhook to https://APP_URL/api/mail-inbound?token=INBOUND_WEBHOOK_TOKEN
MAIL_FROM=noreply@example.com           # login codes and service mail
INBOUND_WEBHOOK_TOKEN=

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...         # endpoint https://APP_URL/api/stripe-webhook
STRIPE_PRICE_ID=price_...               # the monthly subscription price
STRIPE_TRIAL_DAYS=7

# ---- Voice notes (optional; any Whisper-compatible /audio/transcriptions endpoint: OpenAI, Groq, DeepInfra) ----
STT_BASE_URL=                            # e.g. https://api.groq.com/openai/v1 or https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1                      # groq: whisper-large-v3-turbo
# Without STT_* the chat page falls back to browser dictation.

# ---- Push notifications (optional; "code needed", "needs your ok", "done" on the phone even with the chat closed) ----
# Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Google (optional; lets customers connect their own calendar, inbox and Drive) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=                   # redirect URI: https://APP_URL/api/google/callback

# The instant "On it." bubble when a task starts. Off by default: the page shows typing dots and "typing…"
# the moment a task starts, and anything over a minute gets its own tell_user line.
# CHAT_ACKS=on
