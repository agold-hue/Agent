# ---- Required ----
DATABASE_URL=postgres://user:pass@host:5432/workmate     # any Postgres (Neon, Supabase, Fly Postgres, RDS, docker-compose's db)
ANTHROPIC_API_KEY=sk-ant-...                             # console.anthropic.com
MASTER_KEY=                                              # 32 random bytes, base64:  openssl rand -base64 32   (encrypts passwords and mailbox secrets)
SESSION_SECRET=                                          # any long random string:   openssl rand -hex 32
APP_URL=https://workmate.example.com                     # public URL of this service (links in notifications, Stripe return URLs)

# ---- Platform mailbox (sign-in codes, notifications, and the default sender when a business has no mailbox connected) ----
SMTP_HOST=smtp.postmarkapp.com                           # or smtp.gmail.com / smtp.resend.com / smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=workmate@example.com

# ---- Test deployment shortcut ----
# With DEV_LOGIN_CODE set, everyone signs in with this code and no SMTP is needed. Remove it before real customers.
DEV_LOGIN_CODE=

# ---- Models ----
MODEL_TASK=claude-opus-5          # runs the tasks. claude-sonnet-5 is the cheaper option; measure cost per finished task, not per call
MODEL_FAST=claude-haiku-4-5       # mail triage and short classification
MODEL_EFFORT=high                 # low | medium | high | xhigh | max  (medium is a good cost/quality point for routine work)
MODEL_MAX_TOKENS=32000
LLM_FALLBACKS=on                  # server-side refusal fallbacks (beta); switched off automatically if the API rejects the parameter
CONTEXT_PRUNE_TOKENS=120000       # when a task's conversation passes this, old tool results are stubbed in one pass
CONTEXT_KEEP_RECENT=12

# ---- Task budgets (per task) ----
TASK_MAX_STEPS=150
TASK_MAX_MINUTES=45
TASK_MAX_USD=10
WORKER_CONCURRENCY=4              # tasks running at once in this process
WORKER_PER_ORG=3                  # per business
TASK_STALE_SECONDS=180            # a running task without a heartbeat this long is requeued (crash recovery)

# ---- Monthly model-spend cap per business by plan (Stripe price metadata "plan"; DEFAULT otherwise) ----
PLAN_CAP_USD_DEFAULT=100
PLAN_CAP_USD_PRO=400

# ---- Browser ----
BROWSER_HEADLESS=true
BROWSER_IDLE_MINUTES=10           # close a business's browser after this long unused (the profile on disk keeps its logins)
BROWSER_WIDTH=1280
BROWSER_HEIGHT=900
PAGE_SETTLE_MS=6000               # how long a page may take to draw its controls before the worker reads it
SNAPSHOT_MAX_CHARS=24000
# BROWSER_WS_ENDPOINT=wss://...   # optional: a hosted stealth browser (Browserbase etc.) instead of local Chromium; profiles are then the provider's job

# ---- Web search (optional; DuckDuckGo is used without a key) ----
SERPER_API_KEY=

# ---- Billing (optional; without it every business has access) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=            # endpoint: https://APP_URL/api/stripe/webhook  events: customer.subscription.*
STRIPE_PRICE_ID=
STRIPE_TRIAL_DAYS=7

# ---- Web push (optional):  npx web-push generate-vapid-keys ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Misc ----
PORT=3000
DATA_DIR=./data                   # browser profiles and files; a persistent volume in production
MAIL_POLL_SECONDS=60
