# ---- Anthropic (Managed Agents) ----
ANTHROPIC_API_KEY=sk-ant-...
# Signing key from Console -> Manage -> Webhooks (shown once at creation)
ANTHROPIC_WEBHOOK_SIGNING_KEY=whsec_...
# Filled in by `npm run provision`
AGENT_ID=agent_...
ENVIRONMENT_ID=env_...
MEMORY_STORE_ID=memstore_...
SANDBOX_TOOLS_FILE_ID=file_...

# ---- Browserbase (hosted browser) ----
BROWSERBASE_API_KEY=bb_live_...
BROWSERBASE_PROJECT_ID=...
# Persistent browser profile (cookies survive between tasks). Filled in by provision.
BROWSERBASE_CONTEXT_ID=...

# ---- 1Password (site passwords) ----
# Service account token with read access (and write access if the agent may save new logins)
OP_SERVICE_ACCOUNT_TOKEN=ops_...
# Vault ID that holds the site logins the agent may use
OP_VAULT_ID=...

# ---- Gmail (front door) ----
GMAIL_CLIENT_ID=...
GMAIL_CLIENT_SECRET=...
GMAIL_REFRESH_TOKEN=...
# The mailbox the agent reads and replies from
AGENT_EMAIL=agent@example.com
# Only mail from this address is treated as instructions
OWNER_EMAIL=you@example.com
# Optional: a word that must appear in the subject or body for a mail to be treated as a task
TASK_PASSPHRASE=

# ---- Chat ----
# Password for the chat page (public/index.html). Single owner.
CHAT_PASSWORD=change-me-too
# The owner's time zone; every message is timestamped in it so "next Wednesday" resolves correctly
OWNER_TIMEZONE=America/New_York
# A chat session stays warm for this long; after that a fresh one starts (memory carries over)
CHAT_SESSION_MAX_AGE_HOURS=12

# ---- Outbound email / projects ----
# Used in the From display name of emails the agent sends to third parties: "<name> (assistant)"
OWNER_NAME=
# Copy you on every email the agent sends to someone else
CC_OWNER_ON_OUTBOUND=true
# Hour (0-23, in OWNER_TIMEZONE) for the daily project review; -1 disables it
DAILY_REVIEW_HOUR=8
# Proactive mail: set up Gmail auto-forwarding from your own inbox to AGENT_EMAIL (filtered to
# receipts, bills, shipping, confirmations) and the agent will triage what arrives and text you
# only when something matters
OBSERVE_FORWARDED_MAIL=false

# ---- Owner's own Google account (calendar, inbox, Drive) ----
# Refresh token for the OWNER's Google account, same OAuth client as above, scopes:
# https://www.googleapis.com/auth/calendar https://www.googleapis.com/auth/gmail.modify https://www.googleapis.com/auth/drive.file
OWNER_GOOGLE_REFRESH_TOKEN=
# Optional Drive folder id to file everything under
DRIVE_FOLDER_ID=

# ---- Household ----
# Other people whose emails count as requests (replies go to them; the owner's approval rules still apply)
FAMILY_EMAILS=

# ---- Interruptions ----
# Owner-local hours during which non-urgent heads-ups wait, e.g. 22-7
QUIET_HOURS=22-7
# Times of day when held heads-ups go out as one message; empty = send immediately
BATCH_TIMES=12:30,18:00
# Weekly review: day and hour, owner time, e.g. "Sun 18"; empty disables
WEEKLY_REVIEW=Sun 18

# ---- Policy ----
# Money-moving actions at or under this USD amount run without asking (0 = always ask)
AUTO_APPROVE_MAX_USD=0
# Comma-separated action types that never need approval regardless of amount
# (purchase, payment, message, account_change, delete, signup, other). "message" also
# lets the agent email third parties without holding each one for your yes.
AUTO_APPROVE_TYPES=
# Hours to wait for an answer to a clarifying question before proceeding with defaults
ASK_USER_DEADLINE_HOURS=4
# Hard per-task spend cap on Anthropic usage, USD
SESSION_BUDGET_USD=15

# ---- Routes ----
# Vercel sends this as a Bearer token on cron invocations; also used for Pub/Sub push (?token=)
CRON_SECRET=change-me
