{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/inbox.ts": { "maxDuration": 300 },
    "api/anthropic-webhook.ts": { "maxDuration": 300 },
    "api/chat/send.ts": { "maxDuration": 60 },
    "api/chat/history.ts": { "maxDuration": 60 },
    "api/chat/upload.ts": { "maxDuration": 60 },
    "api/chat/stream.ts": { "maxDuration": 300 }
  },
  "crons": [
    { "path": "/api/inbox", "schedule": "* * * * *" }
  ]
}
