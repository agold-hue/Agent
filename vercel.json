{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "{db/**,agent/**,eval/**,node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs}"
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "* * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path((?!index).*)",
      "destination": "/api/index?path=:path"
    }
  ],
  "headers": [
    {
      "source": "/(app|index)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    }
  ]
}
